{
  "name": "commonground",
  "version": "1.0.0",
  "description": "CommonGround Platform",
  "private": true,
  "scripts": {
    "infra:start": "docker compose up -d",
    "infra:init": "bash ./scripts/infra-init-schemas.sh",
    "infra:reset": "bash ./scripts/infra-init-schemas.sh --reset",
    "db:reset": "bash ./scripts/db-reset-marten.sh",
    "infra:down": "docker compose down",
    "dotnet:restore": "dotnet restore src/CommonGround.slnx",
    "dotnet:build": "dotnet build src/CommonGround.slnx",
    "dotnet:test": "dotnet test src/CommonGround.slnx",
    "dotnet:format": "dotnet format src/CommonGround.slnx",
    "api:start": "cd src/CommonGround.API && dotnet run",
    "gateway:start": "cd src/CommonGround.Web.Gateway && dotnet run",
    "frontend:start": "cd src/CommonGround.Web && npm run dev",
    "frontend:build": "cd src/CommonGround.Web && npm run build",
    "frontend:lint": "cd src/CommonGround.Web && npm run lint",
    "frontend:lint:colors": "cd src/CommonGround.Web && npm run lint:colors",
    "frontend:lint:styles": "cd src/CommonGround.Web && npm run lint:styles",
    "frontend:guardrails": "cd src/CommonGround.Web && npm run lint:guardrails",
    "frontend:test": "cd src/CommonGround.Web && npm run test",
    "frontend:generate": "bash ./scripts/generate-api-clients.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
