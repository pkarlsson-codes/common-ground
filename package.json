{
  "name": "commonground",
  "version": "1.0.0",
  "description": "CommonGround Platform",
  "private": true,
  "scripts": {
    "infra:start": "docker compose up -d",
    "infra:init": "bash ./scripts/infra-init-schemas.sh",
    "infra:reset": "bash ./scripts/infra-init-schemas.sh --reset",
    "db:reset": "bash ./scripts/db-reset-marten.sh && npm run db:seed",
    "db:seed": "dotnet run --project src/CommonGround.API --launch-profile http -- seed",
    "infra:down": "docker compose down",
    "dotnet:restore": "dotnet restore src/CommonGround.slnx",
    "dotnet:build": "dotnet build src/CommonGround.slnx",
    "dotnet:test": "dotnet test src/CommonGround.slnx",
    "dotnet:format": "dotnet format src/CommonGround.slnx",
    "api:start": "cd src/CommonGround.API && dotnet run",
    "management:gateway:start": "cd src/CommonGround.Management.Gateway && dotnet run",
    "homeowner:gateway:start": "cd src/CommonGround.Homeowner.Gateway && dotnet run",
    "management:web:start": "cd src/CommonGround.Management.Web && npm run dev",
    "management:web:build": "cd src/CommonGround.Management.Web && npm run build",
    "management:web:lint": "cd src/CommonGround.Management.Web && npm run lint",
    "management:web:lint:colors": "cd src/CommonGround.Management.Web && npm run lint:colors",
    "management:web:lint:styles": "cd src/CommonGround.Management.Web && npm run lint:styles",
    "management:web:guardrails": "cd src/CommonGround.Management.Web && npm run lint:guardrails",
    "management:web:test": "cd src/CommonGround.Management.Web && npm run test",
    "management:web:generate": "bash ./scripts/generate-api-clients.sh",
    "e2e:install": "cd e2e && npm install && npx playwright install chromium",
    "e2e": "cd e2e && node run.mjs",
    "e2e:ui": "cd e2e && npx playwright test --ui",
    "e2e:demo": "cd e2e && SLOWMO=${SLOWMO:-400} npx playwright test --headed --workers=1",
    "e2e:report": "cd e2e && npx playwright show-report",
    "templates:install": "dotnet new install ./templates/ddd-aggregate --force && dotnet new install ./templates/ddd-vo --force && dotnet new install ./templates/ddd-entity --force && dotnet new install ./templates/ddd-enum --force",
    "templates:uninstall": "dotnet new uninstall ./templates/ddd-aggregate && dotnet new uninstall ./templates/ddd-vo && dotnet new uninstall ./templates/ddd-entity && dotnet new uninstall ./templates/ddd-enum",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
