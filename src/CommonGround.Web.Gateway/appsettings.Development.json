{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "OIDC": {
      "Authority": "http://localhost:7080/realms/commonground-dev",
      "ClientId": "commonground-gateway",
      "ClientSecret": "dev-secret-change-in-prod",
      "PostLoginRedirect": "http://localhost:3000",
      "PostLogoutRedirect": "http://localhost:3000"
    }
  },
  "TokenStore": {
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "commonground:",
    "SlidingExpirationHours": 168
  },
  "Gateway": {
    "BaseUrl": "http://localhost:4000",
    "ApiBaseUrl": "http://localhost:5000",
    "InternalJwtSecret": "dev-internal-jwt-secret-must-be-32ch!"
  },
  "CorePlatform": {
    "ApiBaseUrl": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
}
