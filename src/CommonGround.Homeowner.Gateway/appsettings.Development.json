{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=commonground;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "OIDC": {
      "Authority": "http://localhost:7080/realms/commonground-dev",
      "ClientId": "commonground-homeowner-gateway",
      "ClientSecret": "dev-secret-change-in-prod",
      "PostLoginRedirect": "http://localhost:3001",
      "PostLogoutRedirect": "http://localhost:3001"
    }
  },
  "Gateway": {
    "BaseUrl": "http://localhost:4001",
    "ApiBaseUrl": "http://localhost:5000",
    "InternalJwtSecret": "dev-internal-jwt-secret-must-be-32ch!"
  },
  "CorePlatform": {
    "BaseAddress": "http://localhost:5000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3001"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  }
