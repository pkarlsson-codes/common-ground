{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InternalJwt": {
    "Issuer": "CommonGround.Gateway",
    "Audience": "CommonGround.API"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Documents": {
    "Store": "FileSystem",
    "FileSystem": {
      "RootPath": "data/documents"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "CommonGround": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Using": ["Serilog.Sinks.Console"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
