{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=commonground;Username=postgres;Password=postgres"
  },
  "InternalJwt": {
    "Issuer": "CommonGround.Gateway",
    "Audience": "CommonGround.API",
    "SigningKey": "dev-internal-jwt-secret-change-me"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "dev_user",
    "Password": "dev_password"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4000",
      "https://localhost:4001"
    ]
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UseSsl": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "CommonGround": "Information"
      }
    },
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": { "path": "logs/commonground-api-.txt", "rollingInterval": "Day" }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "Api": {
    "EnableSwagger": true,
    "Security": {
      "RequireAuthentication": false
    }
  }
}
