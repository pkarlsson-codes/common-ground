{
  "name": "commonground-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "echo \"No frontend tests configured yet\"",
    "preview": "vite preview",
    "clean:api": "node -e \"require('fs').rmSync('./src/api',{recursive:true,force:true})\"",
    "generate-api-from-spec": "npm run clean:api && npx @openapitools/openapi-generator-cli generate -i ./api-spec.json -g typescript-fetch -o ./src/api --additional-properties=supportsES6=true,withInterfaces=true,basePath=,nullSafeTypes=true,stringEnums=true"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
