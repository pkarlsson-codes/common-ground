# Copy to deploy/.env and fill in every value. Keep .env private: it holds every secret of the install.
# Make a random secret with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Public host name. Its DNS A (and AAAA) record must point at this server before the first start.
DOMAIN=clt.example.org

POSTGRES_PASSWORD=
# Signs the tokens the gateway sends to the API. At least 32 characters.
INTERNAL_JWT_SIGNING_KEY=
# Shared by Keycloak and the gateway. Keycloak reads it only on the first start (realm import).
GATEWAY_CLIENT_SECRET=

# Keycloak admin console: https://DOMAIN/auth-server/admin/
# Used only on the first start, to create the admin account.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Mail server for sign-up confirmation and password reset emails.
# Keycloak reads these only on the first start; change them later in the admin console (Realm settings > Email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clt.example.org
SMTP_FROM_NAME=CommonGround
SMTP_STARTTLS=true
SMTP_SSL=false
