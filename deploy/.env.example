# Copy to deploy/.env and fill in every value. Keep .env private: it holds every secret of the install.
# Make a random secret with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# Public host name. Its DNS A (and AAAA) record must point at this server before the first start.
DOMAIN=clt.example.org

POSTGRES_PASSWORD=
# Signs the tokens the gateway sends to the API. At least 32 characters.
INTERNAL_JWT_SIGNING_KEY=
# Shared by Keycloak and the gateway. Keycloak reads it only on the first start (realm import).
GATEWAY_CLIENT_SECRET=

# Keycloak admin console: https://DOMAIN/auth-server/admin/
# Used only on the first start, to create the admin account.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Mail server for sign-up confirmation and password reset emails.
# Keycloak reads these only on the first start; change them later in the admin console (Realm settings > Email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clt.example.org
SMTP_FROM_NAME=CommonGround
SMTP_STARTTLS=true
SMTP_SSL=false

# Demo mode: a public demo server where each visitor who signs up gets their own sample trust.
# Leave DEMO_ENABLED=false on a server that holds a real CLT's records.
# In demo mode every trust is deleted DEMO_SANDBOX_DAYS after it is created, including an empty trust.
# Turn it on only on a fresh database: a trust created before it was on is never deleted.
# Visitors sign up through Keycloak and must confirm their email, so the SMTP settings above must work.
# Keycloak accounts are not deleted with the trust; remove them in the admin console if a visitor asks.
DEMO_ENABLED=false
DEMO_SANDBOX_DAYS=14
# How many sample and empty trusts may exist at once. Past it, Onboarding says the demo is full.
DEMO_MAX_SANDBOXES=100
# Where "Send feedback" goes: a mailto: link or a form's https address. Required when DEMO_ENABLED=true.
DEMO_FEEDBACK_URL=
